[resource]
script = ExtResource("1_dados")
retrato_derrota = ExtResource("retrato_derrota")
frases_derrota = Array[String](["Quase perdi a cabeça jogando contra ti... brincadeira, essa eu já perdi faz tempo.", "Se eu tivesse cabeça, ia rir da tua cara agora.", "Sem cabeça e mesmo assim pensei mais rápido que tu.", "Tu tem fogo no cabelo, eu tenho fogo no lugar da cabeça. Ganhei."])
nome = "Mula sem Cabeça"
id_progresso = "fase1"
recompensa = "Bola de Fogo e Canhão Flamejante"
vida = 1200
vida_extra_expert = 400
pausa_entre_ataques = 1.2
golpes_contato = 1
fases_normal = Array[ExtResource("fase_chefe")]([SubResource("Fase_normal1")])
fases_expert = Array[ExtResource("fase_chefe")]([SubResource("Fase_expert1")])
cena_bola = ExtResource("2_bola")
cena_onda = ExtResource("4_onda")
cena_meteoro = ExtResource("3_met")
